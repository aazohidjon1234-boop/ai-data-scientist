# ========================= AI Data Scientist Agent =========================
# Copy to .env and adjust. NEVER commit real secrets.

# --- Database ---------------------------------------------------------------
# Used by docker-compose (PostgreSQL). For local dev without Docker the
# backend defaults to SQLite (backend/data/app.db).
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai_secret_change_me
POSTGRES_DB=ai_data_scientist

# Direct SQLAlchemy URL (only needed if you run the backend outside Docker
# against Postgres):
# DATABASE_URL=postgresql+psycopg2://ai:ai_secret_change_me@localhost:5432/ai_data_scientist

# --- CORS (origins allowed to call the API directly) ------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_ROWS=1000000

# --- Optional LLM for interpretation (OpenAI-compatible) ---------------------
# When LLM_API_KEY is empty the built-in local explanation engine is used —
# the app works fully without any LLM. The LLM only *interprets* results and
# is instructed to cite only numbers that exist in the computed JSON.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
